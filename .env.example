# Alist 服务地址
ALIST_URL=https://your-alist-domain.com

# Alist 登录凭据
ALIST_USERNAME=your_username
ALIST_PASSWORD=your_password

# 插件服务端口
PORT=7070

# 标题解析 API Key（二选一，推荐 TMDB，用于 IMDB/TMDB ID → 中文/英文标题）
# TMDB 免费申请: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# OMDB 免费申请: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
